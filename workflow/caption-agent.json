    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "texto = _items[0][\"json\"][\"content\"][\"parts\"][0][\"text\"].strip()\n\n# garante que não passa do limite do Instagram (2.200 caracteres)\nif len(texto) > 2200:\n    texto = texto[:2190] + \"...\"\n\n# garante que as hashtags da BStech estão presentes\nif \"#bstech\" not in texto.lower():\n    texto += \"\\n\\n#bstech #tecnologia #sites\"\n\nreturn [{\"json\": {\"legenda_final\": texto}}]"
      },
